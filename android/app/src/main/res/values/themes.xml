<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ulak_bg">#0B1220</color>
    <color name="ulak_sky">#38BDF8</color>
    <color name="ulak_icon_bg">#0F172A</color>

    <style name="Theme.Ulak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ulak_bg</item>
        <item name="android:colorAccent">@color/ulak_sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Share sheet: translucent so the sending app stays visible behind it -->
    <style name="Theme.Ulak.Sheet" parent="Theme.Ulak">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
